# Copie este arquivo para .env e ajuste. O .env fica fora do git (veja o .gitignore) e só vale em desenvolvimento.
# Em produção, defina estas variáveis no painel da Vercel. Nunca coloque valores reais neste arquivo.

# Conexão com o PostgreSQL. Para o Neon, use a connection string do projeto (a aplicação remove o "-pooler" sozinha).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/siteauth

# Endereço público do site, sem barra no final. Os links dos e-mails são montados a partir dele
# (o cabeçalho Host nunca é usado). Sem esta variável, e-mails com link não são enviados.
APP_URL=http://localhost:8081

# Provedor de e-mail: log (padrão, só registra no log do servidor), resend ou brevo.
MAIL_PROVIDER=log
MAIL_API_KEY=
MAIL_FROM=Site Auth <no-reply@example.com>

# Use 0 se o site NÃO estiver atrás da Vercel: o IP passa a vir só de REMOTE_ADDR.
# TRUST_VERCEL_IP=1
