# Copie este arquivo para .env e preencha com a connection string do seu projeto no Neon.
# O arquivo .env fica fora do git (veja o .gitignore). Em produção, use as variáveis de ambiente da Vercel.
DATABASE_URL=postgresql://seu_usuario:sua_senha@ep-xxxx.neon.tech/dbname?sslmode=require&channel_binding=require
